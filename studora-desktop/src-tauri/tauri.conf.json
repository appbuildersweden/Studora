{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Studora",
  "version": "1.0.0",
  "identifier": "se.studora.app",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "cd .. && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Studora",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://*.supabase.co; frame-src 'self'"
    }
  },    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "nsis": {
          "installMode": "currentUser"
        }
      }
    }
}
